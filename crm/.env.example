# Локальный порт intake-сервиса
PORT=4174
HOST=127.0.0.1

# mock — локальная запись в data/leads.ndjson
# bitrix24 — Bitrix24 Cloud (РФ)
# espocrm — self-hosted EspoCRM на российском VPS
CRM_PROVIDER=mock

# CORS: сайт, с которого разрешены заявки
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Куда писать mock/аудит. На VPS — отдельная папка с правами 700.
DATA_DIR=./data

# Bitrix24 incoming webhook (секрет, не коммитить).
# Пример: https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/
BITRIX24_WEBHOOK_URL=

# EspoCRM REST API
ESPO_BASE_URL=
ESPO_API_KEY=

# Уведомление менеджеру в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
