[Unit]
Description=run800 Telegram stats snapshot (ЮБ800)
Documentation=file:///opt/yb800-bot/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=yb800bot
Group=yb800bot
WorkingDirectory=/opt/yb800-bot
EnvironmentFile=/opt/yb800-bot/.env
ExecStart=/usr/bin/node /opt/yb800-bot/stats.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/yb800-bot/data
UMask=0077
