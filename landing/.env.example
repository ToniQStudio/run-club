# Токен бота из @BotFather. Только серверная переменная, не в браузере.
TELEGRAM_BOT_TOKEN=

# ID чата или канала, куда падают заявки. Для канала начинается с -100.
# Можно использовать то же значение, что MANAGER_CHAT_ID у бота.
TELEGRAM_CHAT_ID=
# MANAGER_CHAT_ID=

# 1 — локальный mock без отправки в Telegram. 0 — реальная отправка.
MOCK_TELEGRAM=0
